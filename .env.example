# Copy to .env (gitignored) and fill in the three required keys.
# This file holds secrets, machine-specific paths and operator policy only (ADR-004);
# workflow behaviour knobs live in workflows/<name>/src/<name>/config.py.
# deploy.sh uploads ONLY OPENAI_API_KEY, TELEGRAM_BOT_TOKEN, ADMIN_TELEGRAM_ID,
# LOG_LEVEL, YTDLP_PROXY, BOT_* and NOTES_* to the droplet; everything else stays on your machine.
# The two exceptions: TS_AUTHKEY goes to the funnel container alone, and the Mini App container
# gets ADMIN_TELEGRAM_ID, LOG_LEVEL and a key derived from the bot token, never the token itself.

# --- Required ---------------------------------------------------------------
# https://platform.openai.com/api-keys — every workflow bills against this key.
OPENAI_API_KEY=
# Telegram: message @BotFather, send /newbot, paste the token it gives you.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (not @username): message @userinfobot to get it.
# This account is the admin: it mints invites and is exempt from the daily cap.
ADMIN_TELEGRAM_ID=

# --- Bot policy (defaults shown) --------------------------------------------
# Languages offered in /settings, comma-separated; the two defaults are always included.
BOT_LANGUAGES=English,Russian,Chinese,Japanese,Korean,French,German,Spanish
# Defaults for a new user until they change them in /settings.
BOT_DEFAULT_SOURCE_LANGUAGE=English
BOT_DEFAULT_TARGET_LANGUAGE=Russian
# Refuse any single job estimated above this (USD).
BOT_MAX_JOB_COST_USD=10
# Refuse a non-admin user's job once their rolling 24h spend would exceed this (USD).
BOT_DAILY_USER_COST_LIMIT_USD=25

# --- YouTube egress (optional, ADR-014) --------------------------------------
# Datacenter IPs often get "Sign in to confirm you're not a bot" from YouTube.
# Any proxy URL yt-dlp understands works here. To use the bundled free Cloudflare
# WARP sidecar, set both lines below; WARP_ACCEPT_TOS=yes means YOU accept
# https://www.cloudflare.com/application/terms/ — deploy.sh then starts the sidecar.
#YTDLP_PROXY=socks5h://warp:40000
#WARP_ACCEPT_TOS=yes

# --- Storage ----------------------------------------------------------------
# sqlite file: users, invites, per-user settings, usage log.
TELEGRAM_DB_PATH=data/telegram_bot.sqlite3
# sqlite file of the admin's notes (apps/notes, ADR-015); compose pins /data/notes.sqlite3.
NOTES_DB_PATH=data/notes.sqlite3
# sqlite file of the admin's diary (apps/diary, ADR-020), Mini App only; compose pins /data/diary.sqlite3.
DIARY_DB_PATH=data/diary.sqlite3

# --- Notes (admin only, ADR-015) -------------------------------------------
# Who files Items into Sections and writes the Gist: `openai` (bills OPENAI_API_KEY, ~$0.002
# an Item) or `fake` (offline, everything to Other).
NOTES_CLASSIFIER_PROVIDER=openai
# Empty = the default translation model from shared/pricing.py.
NOTES_CLASSIFIER_MODEL=
# How often the sweeper retries failed / interrupted enrichment (seconds).
NOTES_ENRICH_SWEEP_SECONDS=60

# --- Admin Mini App (ADR-016) -----------------------------------------------
# Public HTTPS URL of the Mini App (notes + usage) behind the 📒 button in the admin's chat.
# With Tailscale Funnel: https://maxi-bot.<your-tailnet>.ts.net (owner steps: infrastructure/README.md).
# Empty = no 📒 menu button and no 📅 Перенести on Reminders.
BOT_MINIAPP_URL=
# Tailscale auth key for the funnel sidecar (not ephemeral, pre-approved). Unset = no Funnel.
#TS_AUTHKEY=
# MINIAPP_INIT_SECRET is derived from the bot token by deploy.sh; only a local `telegram-miniapp`
# run without TELEGRAM_BOT_TOKEN needs it set by hand.

# --- Logging / tracing ------------------------------------------------------
LOG_LEVEL=INFO
# Tracing is opt-in and needs the local ELK/APM stack (docs/observability/tracing-elk.md).
OTEL_ENABLED=false
OTEL_SERVICE_NAMESPACE=maxi_bot
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8200
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=

# --- Deployment only (read by infrastructure/ Terraform and ssh-gate.sh, never by app code,
# --- never uploaded). Scopes that are enough day to day: infrastructure/README.md ------------
# https://cloud.digitalocean.com/account/api/tokens
DO_API_KEY=
